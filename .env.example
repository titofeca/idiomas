# LinguaQuest - Variables de entorno (Opcional)
# Puedes configurar tu API Key directamente en la app (botón "IA")
# o definirla aquí si despliegas en tu servidor / hosting.

# OpenRouter (Recomendado: acceso a DeepSeek, Llama 3, Gemini gratis y de pago)
VITE_OPENROUTER_API_KEY=

# DeepSeek Oficial Directo
VITE_DEEPSEEK_API_KEY=

# Telegram Bot (para el script telegram-bot/bot.mjs)
TELEGRAM_BOT_TOKEN=
APP_URL=https://localhost:5173
